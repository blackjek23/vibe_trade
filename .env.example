# Vibe Trade — Environment Variables
# Copy this to .env and fill in your values.
# These override values in config/config.toml.

# Telegram Bot (required if telegram.enabled = true)
VIBE_TRADE_TELEGRAM_TOKEN=
VIBE_TRADE_TELEGRAM_CHAT_ID=

# IB Account (optional — blank = first available account)
VIBE_TRADE_BROKER_ACCOUNT=
