[Unit]
Description=vibe-trade reconcile (finalize statuses + portfolio snapshot)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=vibe
Group=vibe
WorkingDirectory=/opt/vibe-trade/deploy
ExecStart=/usr/bin/docker compose run --rm reconcile
StandardOutput=append:/opt/vibe-trade/deploy/logs/cron.log
StandardError=append:/opt/vibe-trade/deploy/logs/cron.log
