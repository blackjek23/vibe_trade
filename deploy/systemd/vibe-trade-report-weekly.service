[Unit]
Description=vibe-trade weekly report (dashboard PNG + Telegram)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=vibe
Group=vibe
WorkingDirectory=/opt/vibe-trade/deploy
ExecStart=/usr/bin/docker compose run --rm report-weekly
StandardOutput=append:/opt/vibe-trade/deploy/logs/cron.log
StandardError=append:/opt/vibe-trade/deploy/logs/cron.log
